# Copie para .env.production e preencha os valores reais antes de colar
# no editor de variáveis de ambiente do Stack no Portainer (não versionar
# o .env.production preenchido).

# --- Domínios ---
APP_URL=https://clinic.sondercorp.com.br
API_URL=https://api.clinic.sondercorp.com.br
APP_HOST=clinic.sondercorp.com.br
API_HOST=api.clinic.sondercorp.com.br

# --- Traefik ---
# Nome do certresolver configurado na sua instância do Traefik (Let's Encrypt).
# Ajuste se o seu Traefik usa outro nome (ex: "le", "letsencryptresolver").
TRAEFIK_CERT_RESOLVER=letsencrypt

# --- Branding ---
BRAND_NAME=Sonder Clinic
BRAND_PRIMARY_COLOR=#176B5B
TZ=America/Cuiaba

# --- Imagens (GHCR) ---
# Trave em uma tag/sha específico em produção, evite depender só de "latest".
WEB_IMAGE=ghcr.io/mond-day/sonder-clinic-web:1.2.4
API_IMAGE=ghcr.io/mond-day/sonder-clinic-api:1.2.4
WORKER_IMAGE=ghcr.io/mond-day/sonder-clinic-worker:1.2.4

# --- Banco de dados (Postgres gerenciado, fora desta stack) ---
DATABASE_URL=postgresql://usuario:senha@host:5432/sonder_clinic?schema=public

# --- Redis (já existente no seu Portainer) ---
REDIS_URL=redis://redis:6379

# --- Storage S3/MinIO (já existente no seu Portainer) ---
S3_ENDPOINT=http://minio:9000
S3_BUCKET=sonder-clinic

# --- SMTP (obrigatório para "esqueci minha senha" / convites) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=

# --- Antivírus (opcional) ---
AV_DRIVER=disabled

# --- IA (opcional) ---
AI_PROVIDER=OPENAI
OPENAI_MODEL=gpt-4o-mini

# --- Réplicas (opcional, defaults = 1) ---
# WEB_REPLICAS=1
# API_REPLICAS=1
# WORKER_REPLICAS=1
