# Runtime
NODE_ENV=development
TZ=America/Cuiaba

# Apps
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
APP_HOST=app.sonder.clinic
API_HOST=api.sonder.clinic

# Branding and legal fallbacks (tenant settings override these)
BRAND_NAME=Sonder
BRAND_SUBTITLE=Clinic
BRAND_PRIMARY_COLOR=#176B5B
# BRAND_LOGO_URL=
# BRAND_FAVICON_URL=
PRIVACY_CONTACT_EMAIL=privacidade@sonder.clinic

# SMTP (obrigatório para "Esqueci minha senha")
# Sem SMTP_HOST o fluxo retorna erro explícito — nunca simula sucesso.
# SMTP_HOST=
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Database (dev password: senha123)
DATABASE_URL=postgresql://sonder:senha123@localhost:5432/sonder_clinic?schema=public

# Queue: memory (dev) | redis (prod)
QUEUE_DRIVER=memory
# REDIS_URL=redis://localhost:6379
# WORKER_EMBEDDED=true

# Auth
JWT_ACCESS_SECRET=change-me-access-dev-only-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-dev-only-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false

# Crypto (32-byte hex for AES-256-GCM master key)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=.data/storage
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minio
# S3_SECRET_KEY=minio123
# S3_BUCKET=sonder-clinic

# Antivirus
# stub|disabled = não marca CLEAN; clamav = INSTREAM TCP (requer daemon)
AV_DRIVER=stub
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# Integrations (leave empty + MOCK=true for stubs)
NIBO_MOCK=true
# NIBO_API_TOKEN=
# NIBO_BASE_URL=https://api.nibo.com.br/empresas/v1
# Autenticação: header ApiToken (não Authorization). Token da empresa em Mais opções → Configurações → API.

EVOLUTION_MOCK=true
# EVOLUTION_BASE_URL=
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=
# EVOLUTION_SEND_DELAY_MS=1500
# EVOLUTION_MIN_INTERVAL_MS=4000

ABACATEPAY_MOCK=true
# ABACATEPAY_API_KEY=
# ABACATEPAY_BASE_URL=https://api.abacatepay.com/v2
# ABACATEPAY_WEBHOOK_SECRET=
# Webhook: POST /api/v1/integrations/abacatepay/webhook (HMAC e/ou webhookSecret).
# Fallback: POST /api/v1/payments/:id/sync (GET /v2/transparents/check).

CHATWOOT_MOCK=true
# CHATWOOT_BASE_URL=
# CHATWOOT_API_ACCESS_TOKEN=
# CHATWOOT_ACCOUNT_ID=
# CHATWOOT_INBOX_ID=

# Google Calendar OAuth (Fatia 4 / A38) + webhook push (última milha)
# MOCK=true → UI/API desabilitados com falha honesta.
# Live: MOCK=false + clientId/secret + redirect + OAuth consent (refresh_token).
GOOGLE_CALENDAR_MOCK=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback
# GOOGLE_CALENDAR_ID=primary
# Push notify (HTTPS público exigido pelo Google). Sem URL → só pull-sync manual.
# GOOGLE_CALENDAR_WEBHOOK_URL=https://api.seudominio.com/api/v1/integrations/google/calendar/webhook
# GOOGLE_CALENDAR_WEBHOOK_TOKEN=  # opcional; gerado e persistido no register watch se omitido
# Registrar canal: POST /integrations/:id/calendar/watch (após OAuth).
# Auto-renew do canal (worker):
GOOGLE_CALENDAR_WATCH_AUTO_RENEW=true
# GOOGLE_CALENDAR_WATCH_RENEW_LEAD_HOURS=24
# GOOGLE_CALENDAR_WATCH_RENEW_INTERVAL_MS=21600000
# ANAMNESIS_EXPIRE_INTERVAL_MS=3600000

OPENAI_MOCK=true
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=OPENAI
INTEGRATION_SCOPE_DEFAULT=CLINIC

# A1: never commit file/password; prefer Docker secrets in production.
# Novos uploads usam @sonder/storage (STORAGE_DRIVER/local ou MinIO).
# CERTIFICATE_LOCAL_PATH=.data/certificates  # legado (pré-1.1.2)
# A1_CERTIFICATE_PATH=/run/secrets/a1_certificate
# A1_PASSWORD_FILE=/run/secrets/a1_password

# Codental import remains disabled until files are supplied
CODENTAL_IMPORT_ENABLED=false
# CODENTAL_IMPORT_PATH=

# Observability
# OTEL_ENABLED=true ativa SDK (console sem endpoint; OTLP com endpoint)
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_DIAG_LOG=false
LOG_LEVEL=info

# Swagger: development on by default; production off unless SWAGGER_ENABLED=true
# SWAGGER_ENABLED=true
# Em produção com Swagger ligado, restrinja /docs por rede ou autenticação.

# Production fail-fast (NODE_ENV=production): exige JWT fortes, ENCRYPTION_MASTER_KEY
# (64 hex ≠ default), COOKIE_SECURE=true, DATABASE_URL não-localhost, QUEUE_DRIVER=redis,
# REDIS_URL, STORAGE_DRIVER≠local, CORS_ORIGIN explícito.
# Readiness: GET /api/v1/health/ready

