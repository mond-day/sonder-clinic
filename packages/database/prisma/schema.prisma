  amount         Decimal   @db.Decimal(12, 2)
  frequency      String
  interval       Int       @default(1)
  nextOccurrence DateTime  @db.Date
  endsAt         DateTime? @db.Date
  active         Boolean   @default(true)
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, clinicId, active, nextOccurrence])
}

model CommissionPeriod {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  clinicId       String    @db.Uuid
  referenceMonth DateTime  @db.Date
  status         String    @default("OPEN")
  closedAt       DateTime?
  closedById     String?   @db.Uuid
  createdAt      DateTime  @default(now())
  events         CommissionEvent[]

  @@unique([clinicId, referenceMonth])
  @@index([organizationId, clinicId, status])
}

model CommissionEvent {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  clinicId         String           @db.Uuid
  professionalId   String           @db.Uuid
  ruleId           String           @db.Uuid
  periodId         String?          @db.Uuid
  sourceType       String
  sourceId         String
  basisAmount      Decimal          @db.Decimal(12, 2)
  commissionAmount Decimal          @db.Decimal(12, 2)
  status           CommissionStatus @default(FORECASTED)
  occurredAt       DateTime
  metadata         Json             @default("{}")
  period           CommissionPeriod? @relation(fields: [periodId], references: [id])

  @@unique([sourceType, sourceId, ruleId])
  @@index([organizationId, clinicId, professionalId, occurredAt])
  @@index([periodId, status])
}

model FinancialReconciliation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  clinicId       String    @db.Uuid
  periodStart    DateTime  @db.Date
  periodEnd      DateTime  @db.Date
  status         JobStatus @default(PENDING)
  summary        Json      @default("{}")
  divergences    Json      @default("[]")
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([organizationId, clinicId, createdAt])
}

model CommissionRule {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  clinicId         String?   @db.Uuid
  professionalId   String?   @db.Uuid
  procedureId      String?   @db.Uuid
  specialty        String?
  basis            String
  calculationType  String
  value            Decimal   @db.Decimal(12, 4)
  deductions       Json      @default("{}")
  reversalBehavior String    @default("REVERSE")
  validFrom        DateTime  @db.Date
  validUntil       DateTime? @db.Date
  priority         Int       @default(0)
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  @@index([organizationId, active, priority])
}

model CommissionEntry {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @db.Uuid
  clinicId        String             @db.Uuid
  professionalId  String             @db.Uuid
  treatmentItemId String?            @db.Uuid
  paymentId       String?            @db.Uuid
  triggeringEvent String
  snapshot        Json
  baseAmount      Decimal            @db.Decimal(12, 2)
  amount          Decimal            @db.Decimal(12, 2)
  status          CommissionStatus   @default(FORECASTED)
  competence      DateTime           @db.Date
  closingId       String?            @db.Uuid
  createdAt       DateTime           @default(now())
  closing         CommissionClosing? @relation(fields: [closingId], references: [id])

  @@index([organizationId, clinicId, professionalId, competence])
}

model CommissionClosing {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  clinicId       String            @db.Uuid
  periodStart    DateTime          @db.Date
  periodEnd      DateTime          @db.Date
  status         String            @default("DRAFT")
  total          Decimal           @default(0) @db.Decimal(12, 2)
  approvedById   String?           @db.Uuid
  approvedAt     DateTime?
  paidAt         DateTime?
  createdAt      DateTime          @default(now())
  entries        CommissionEntry[]

  @@index([organizationId, clinicId, periodStart])
}

model MessagingChannel {
  id                   String            @id @default(uuid()) @db.Uuid
  organizationId       String            @db.Uuid
  clinicId             String?           @db.Uuid
  unitId               String?           @db.Uuid
  professionalId       String?           @db.Uuid
  type                 String
  displayName          String
  encryptedCredentials String?
  configuration        Json              @default("{}")
  status               EntityStatus      @default(ACTIVE)
  createdAt            DateTime          @default(now())
  deliveries           MessageDelivery[]

  @@index([organizationId, status])
}

model MessageTemplate {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  name            String
  category        String
  content         String
  variables       Json
  requiresConsent Boolean           @default(true)
  active          Boolean           @default(true)
  deliveries      MessageDelivery[]

  @@unique([organizationId, name])
}

model MessageDelivery {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  patientId       String?          @db.Uuid
  appointmentId   String?          @db.Uuid
  channelId       String           @db.Uuid
  templateId      String?          @db.Uuid
  recipient       String
  renderedContent String
  status          DeliveryStatus   @default(PENDING)
  externalId      String?
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  error           String?
  createdAt       DateTime         @default(now())
  channel         MessagingChannel @relation(fields: [channelId], references: [id])
  template        MessageTemplate? @relation(fields: [templateId], references: [id])

  @@index([organizationId, status, createdAt])
}

model CommunicationPreference {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  patientId      String   @db.Uuid
  channel        String
  category       String
  optedIn        Boolean  @default(true)
  changedAt      DateTime @default(now())
  source         String

  @@unique([organizationId, patientId, channel, category])
}

model AutomationRule {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  clinicId       String?  @db.Uuid
  name           String
  trigger        String
  conditions     Json     @default("{}")
  action         Json
  allowedHours   Json     @default("{}")
  frequency      String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([organizationId, active, trigger])
}

model Prescription {
  id               String                  @id @default(uuid()) @db.Uuid
  organizationId   String                  @db.Uuid
  clinicId         String                  @db.Uuid
  patientId        String                  @db.Uuid
  professionalId   String                  @db.Uuid
  folderId         String?                 @db.Uuid
  purpose          String
  items            Json
  clinicalWarnings Json                    @default("[]")
  ignoredWarnings  Json                    @default("[]")
  frozenIdentity   Json?
  status           PrescriptionStatus      @default(DRAFT)
  aiMetadata       Json?
  contentHash      String?
  validationCode   String?                 @unique
  reviewedAt       DateTime?
  reviewedById     String?                 @db.Uuid
  signedAt         DateTime?
  cancelledAt      DateTime?
  cancelledById    String?                 @db.Uuid
  cancelReason     String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  folder           PatientDocumentFolder?  @relation(fields: [folderId], references: [id])

  @@index([organizationId, patientId, createdAt])
  @@index([organizationId, patientId, status])
}

model PrescriptionProtocol {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  professionalId   String?   @db.Uuid
  name             String
  purpose          String
  items            Json
  active           Boolean   @default(true)
  archivedAt       DateTime?
  createdById      String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId, name, professionalId])
  @@index([organizationId, active])
}
