generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INVITED
  BLOCKED
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum IntegrationProvider {
  NIBO
  ABACATEPAY
  EVOLUTION
  CHATWOOT
  GOOGLE_CALENDAR
  OPENAI
}

enum IntegrationStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum JobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum ClinicalEntryStatus {
  DRAFT
  SIGNED
  CORRECTED
  CANCELLED
}

enum TreatmentStatus {
  DRAFT
  PRESENTED
  PARTIALLY_APPROVED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TreatmentItemStatus {
  PLANNED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ToothFindingStatus {
  EXISTING
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum DocumentStatus {
  DRAFT
  GENERATED
  PARTIALLY_SIGNED
  SIGNED
  CANCELLED
}

enum DocumentTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PrescriptionStatus {
  DRAFT
  REVIEWED
  SIGNED
  CANCELLED
}

enum FileStatus {
  PENDING
  UPLOADED
  SCANNING
  AVAILABLE
  REJECTED
}

enum ReceivableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum CommissionStatus {
  FORECASTED
  GENERATED
  RELEASED
  PAID
  REVERSED
  BLOCKED
  PENDING_ADJUSTMENT
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

enum ReturnAlertStatus {
  PENDING
  CONTACTED
  SCHEDULED
  DONE
  DISMISSED
}

enum ReturnChannel {
  WHATSAPP
  PHONE
  EMAIL
  IN_PERSON
}

enum TaskStatus {
  INBOX
  TODAY
  UPCOMING
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum TaskCategory {
  PATIENT
  FINANCE
  LAB
  SCHEDULE
  STOCK
  ADMIN
}

enum LabCaseStatus {
  REQUESTED
  IN_LAB
  RETURNED
  INSTALLED
  CANCELLED
}

enum NotificationCategory {
  CLINICAL
  FINANCE
  TASK
  LAB
  PATIENT
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AnamnesisTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnamnesisResponseStatus {
  DRAFT
  AWAITING_SIGNATURE
  SIGNED
  EXPIRED
  SUPERSEDED
  CANCELLED
}

enum AnamnesisSignatureRole {
  PATIENT
  GUARDIAN
  PROFESSIONAL
}

enum SignatureMethod {
  DRAWN
  REMOTE_LINK
  A1
  REMOTE
  MOCK_A1
}

enum ClinicalCorrectionKind {
  ADDENDUM
  CORRECTION
}

enum PayableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum UserInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Organization {
  id           String        @id @default(uuid()) @db.Uuid
  legalName    String
  tradeName    String
  taxId        String?       @unique
  timezone     String        @default("America/Cuiaba")
  status       EntityStatus  @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  clinics      Clinic[]
  users        User[]
  patients     Patient[]
  roles        Role[]
  agendaTags   AgendaTag[]
  laboratories Laboratory[]
  duplicateDismissals PatientDuplicateDismissal[]
}

model Clinic {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  legalName      String
  tradeName      String
  taxId          String?
  email          String?
  phone          String?
  settingsJson   Json                    @default("{}")
  status         EntityStatus            @default(ACTIVE)
  organization   Organization            @relation(fields: [organizationId], references: [id])
  units          Unit[]
  appointments   Appointment[]
  patientLinks   PatientClinic[]
  integrations   IntegrationConnection[]
  auditEvents    AuditEvent[]
  returnAlerts   ReturnAlert[]
  tasks          Task[]
  labCases       LabCase[]
  agendaTags     AgendaTag[]
  laboratories   Laboratory[]
  payables       Payable[]
  professionalLinks ProfessionalClinic[]
  anamnesisResponses AnamnesisResponse[]

  @@index([organizationId])
}

model Unit {
  id           String        @id @default(uuid()) @db.Uuid
  clinicId     String        @db.Uuid
  name         String
  phone        String?
  timezone     String        @default("America/Cuiaba")
  status       EntityStatus  @default(ACTIVE)
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  chairs       Chair[]
  appointments Appointment[]
  professionalLinks ProfessionalUnit[]

  @@index([clinicId])
}

model Chair {
  id                  String        @id @default(uuid()) @db.Uuid
  unitId              String        @db.Uuid
  name                String
  color               String        @default("#176B5B")
  isSchedulingEnabled Boolean       @default(true)
  status              EntityStatus  @default(ACTIVE)
  unit                Unit          @relation(fields: [unitId], references: [id])
  appointments        Appointment[]

  @@index([unitId])
}

model User {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  name           String
  email          String
  passwordHash   String
  status         UserStatus          @default(ACTIVE)
  lastLoginAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id])
  roles          UserRole[]
  sessions       Session[]
  professional   Professional?
  invitations    UserInvitation[]    @relation("InvitedUsers")
  passwordResets PasswordResetToken[]

  @@unique([organizationId, email])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model UserInvitation {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  email          String
  name           String
  roleId         String               @db.Uuid
  tokenHash      String               @unique
  status         UserInvitationStatus @default(PENDING)
  invitedById    String?              @db.Uuid
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime             @default(now())
  invitedBy      User?                @relation("InvitedUsers", fields: [invitedById], references: [id])

  @@index([organizationId, email, status])
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  name           String
  code           String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  users          UserRole[]
  permissions    RolePermission[]

  @@unique([organizationId, code])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String
  roles       RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
}

model Professional {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @unique @db.Uuid
  name             String
  cpf              String?       @unique
  croNumber        String?
  croState         String?
  professionalType String        @default("DENTIST")
  status           EntityStatus  @default(ACTIVE)
  user             User          @relation(fields: [userId], references: [id])
  appointments     Appointment[]
  returnAlerts     ReturnAlert[]
  labCases         LabCase[]
  clinicLinks      ProfessionalClinic[]
  unitLinks        ProfessionalUnit[]
  specialties      ProfessionalSpecialty[]
}

model ProfessionalClinic {
  id             String       @id @default(uuid()) @db.Uuid
  professionalId String       @db.Uuid
  clinicId       String       @db.Uuid
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  clinic         Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([professionalId, clinicId])
  @@index([clinicId, active])
}

model ProfessionalUnit {
  id             String       @id @default(uuid()) @db.Uuid
  professionalId String       @db.Uuid
  unitId         String       @db.Uuid
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  unit           Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([professionalId, unitId])
  @@index([unitId, active])
}

model ProfessionalSpecialty {
  id             String       @id @default(uuid()) @db.Uuid
  professionalId String       @db.Uuid
  specialty      String
  createdAt      DateTime     @default(now())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, specialty])
  @@index([specialty])
}

model Patient {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  fullName       String
  preferredName  String?
  cpf            String?
  passportNumber String?
  birthDate      DateTime?         @db.Date
  email          String?
  primaryPhone   String
  secondaryPhone String?
  isMinor        Boolean           @default(false)
  status         PatientStatus     @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id])
  clinics        PatientClinic[]
  guardians      PatientGuardian[]
  appointments   Appointment[]
  alerts         PatientAlert[]
  returnAlerts   ReturnAlert[]
  tasks          Task[]
  labCases       LabCase[]
  duplicateDismissalsLow  PatientDuplicateDismissal[] @relation("DuplicateDismissalLow")
  duplicateDismissalsHigh PatientDuplicateDismissal[] @relation("DuplicateDismissalHigh")
  anamnesisResponses AnamnesisResponse[]

  @@unique([organizationId, cpf])
  @@unique([organizationId, passportNumber])
  @@index([organizationId, fullName])
}

/// Par de pacientes marcado como "não são duplicados" (ordem lexicográfica dos IDs).
model PatientDuplicateDismissal {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  patientIdLow   String       @db.Uuid
  patientIdHigh  String       @db.Uuid
  dismissedById  String       @db.Uuid
  reason         String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientLow     Patient      @relation("DuplicateDismissalLow", fields: [patientIdLow], references: [id], onDelete: Cascade)
  patientHigh    Patient      @relation("DuplicateDismissalHigh", fields: [patientIdHigh], references: [id], onDelete: Cascade)

  @@unique([organizationId, patientIdLow, patientIdHigh])
  @@index([organizationId, createdAt])
}

model PatientClinic {
  patientId    String       @db.Uuid
  clinicId     String       @db.Uuid
  internalCode String?
  status       EntityStatus @default(ACTIVE)
  patient      Patient      @relation(fields: [patientId], references: [id])
  clinic       Clinic       @relation(fields: [clinicId], references: [id])

  @@id([patientId, clinicId])
}

model Guardian {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  cpf          String?
  phone        String
  email        String?
  relationship String
  patients     PatientGuardian[]
}

model PatientGuardian {
  patientId       String   @db.Uuid
  guardianId      String   @db.Uuid
  isLegalGuardian Boolean  @default(true)
  canSign         Boolean  @default(true)
  isPrimary       Boolean  @default(false)
  patient         Patient  @relation(fields: [patientId], references: [id])
  guardian        Guardian @relation(fields: [guardianId], references: [id])

  @@id([patientId, guardianId])
}

model PatientAlert {
  id        String  @id @default(uuid()) @db.Uuid
  patientId String  @db.Uuid
  type      String
  message   String
  severity  String  @default("WARNING")
  active    Boolean @default(true)
  patient   Patient @relation(fields: [patientId], references: [id])
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  clinicId       String            @db.Uuid
  unitId         String            @db.Uuid
  patientId      String            @db.Uuid
  professionalId String            @db.Uuid
  chairId        String?           @db.Uuid
  startAt        DateTime
  endAt          DateTime
  status                   AppointmentStatus @default(SCHEDULED)
  source                   String            @default("INTERNAL")
  notes                    String?
  category                 String?
  externalCalendarEventId  String?
  version                  Int               @default(1)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  clinic                   Clinic            @relation(fields: [clinicId], references: [id])
  unit                     Unit              @relation(fields: [unitId], references: [id])
  patient                  Patient           @relation(fields: [patientId], references: [id])
  professional             Professional      @relation(fields: [professionalId], references: [id])
  chair                    Chair?            @relation(fields: [chairId], references: [id])
  tags                     AppointmentTag[]
  reminders                AppointmentReminder[]
  statusEvents             AppointmentStatusEvent[]

  @@index([organizationId, startAt])
  @@index([professionalId, startAt, endAt])
  @@index([chairId, startAt, endAt])
  @@index([externalCalendarEventId])
}

model AppointmentStatusEvent {
  id              String             @id @default(uuid()) @db.Uuid
  appointmentId   String             @db.Uuid
  previousStatus  AppointmentStatus?
  nextStatus      AppointmentStatus
  reasonCode      String?
  reasonText      String?
  previousStartAt DateTime?
  nextStartAt     DateTime?
  actorId         String?            @db.Uuid
  createdAt       DateTime           @default(now())
  appointment     Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}

model AgendaTag {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  clinicId       String           @db.Uuid
  name           String
  color          String           @default("#159a96")
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  clinic         Clinic           @relation(fields: [clinicId], references: [id])
  appointments   AppointmentTag[]

  @@unique([clinicId, name])
  @@index([organizationId, clinicId, active])
}

model AppointmentTag {
  appointmentId String      @db.Uuid
  tagId         String      @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  tag           AgendaTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([appointmentId, tagId])
  @@index([tagId])
}

model AppointmentReminder {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  appointmentId  String      @db.Uuid
  channel        String      @default("WHATSAPP")
  leadMinutes    Int         @default(1440)
  scheduledFor   DateTime
  status         String      @default("DISABLED")
  statusReason   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, channel])
  @@index([organizationId, status, scheduledFor])
}

model ReturnAlert {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  clinicId         String            @db.Uuid
  patientId        String            @db.Uuid
  professionalId   String?           @db.Uuid
  assigneeId       String?           @db.Uuid
  reason           String
  specialty        String?
  dueAt            DateTime
  status           ReturnAlertStatus @default(PENDING)
  preferredChannel ReturnChannel     @default(WHATSAPP)
  contactAttempts  Int               @default(0)
  lastContactAt    DateTime?
  notes            String?
  appointmentId    String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  clinic           Clinic            @relation(fields: [clinicId], references: [id])
  patient          Patient           @relation(fields: [patientId], references: [id])
  professional     Professional?     @relation(fields: [professionalId], references: [id])

  @@index([organizationId, clinicId, status, dueAt])
}

model Task {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  clinicId       String               @db.Uuid
  title          String
  description    String?
  category       TaskCategory         @default(ADMIN)
  priority       TaskPriority         @default(NORMAL)
  status         TaskStatus           @default(INBOX)
  dueAt          DateTime?
  assigneeId     String?              @db.Uuid
  patientId      String?              @db.Uuid
  appointmentId  String?              @db.Uuid
  receivableId   String?              @db.Uuid
  labCaseId      String?              @db.Uuid
  createdById    String?              @db.Uuid
  completedAt    DateTime?
  sourceTaskId   String?              @db.Uuid
  occurrenceKey  String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  clinic         Clinic               @relation(fields: [clinicId], references: [id])
  patient        Patient?             @relation(fields: [patientId], references: [id])
  checklist      TaskChecklistItem[]
  participants   TaskParticipant[]
  comments       TaskComment[]
  attachments    TaskAttachment[]
  recurrence     TaskRecurrence?
  activities     TaskActivity[]

  @@index([organizationId, clinicId, status, dueAt])
}

model TaskActivity {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  actorId   String?  @db.Uuid
  type      String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model TaskChecklistItem {
  id            String    @id @default(uuid()) @db.Uuid
  taskId        String    @db.Uuid
  title         String
  completed     Boolean   @default(false)
  sortOrder     Int
  completedById String?   @db.Uuid
  completedAt   DateTime?
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}

model TaskParticipant {
  taskId String @db.Uuid
  userId String @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model TaskComment {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @db.Uuid
  authorId  String    @db.Uuid
  content   String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model TaskAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @db.Uuid
  fileId      String   @db.Uuid
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model TaskRecurrence {
  id             String    @id @default(uuid()) @db.Uuid
  taskId         String    @unique @db.Uuid
  frequency      String
  interval       Int       @default(1)
  endsAt         DateTime?
  nextOccurrence DateTime?
  active         Boolean   @default(true)
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Laboratory {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  clinicId        String?      @db.Uuid
  name            String
  taxId           String?
  phone           String?
  email           String?
  addressJson     Json         @default("{}")
  specialties     Json         @default("[]")
  defaultLeadDays Int?
  pricingJson     Json         @default("{}")
  notes           String?
  status          EntityStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id])
  clinic          Clinic?      @relation(fields: [clinicId], references: [id])
  cases           LabCase[]

  @@index([organizationId, status])
}

model LabCase {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  clinicId       String              @db.Uuid
  patientId      String              @db.Uuid
  professionalId String?             @db.Uuid
  laboratoryId   String?             @db.Uuid
  code           String
  description    String
  toothFdi       String?
  laboratoryName String
  specialty      String?
  detailedStage  String              @default("REQUEST_CREATED")
  status         LabCaseStatus       @default(REQUESTED)
  sentAt         DateTime?
  dueAt          DateTime?
  returnedAt     DateTime?
  installedAt    DateTime?
  cost           Decimal?            @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  clinic         Clinic              @relation(fields: [clinicId], references: [id])
  patient        Patient             @relation(fields: [patientId], references: [id])
  professional   Professional?       @relation(fields: [professionalId], references: [id])
  laboratory     Laboratory?         @relation(fields: [laboratoryId], references: [id])
  events         LabCaseEvent[]
  stageEvents    LabCaseStageEvent[]
  attachments    LabCaseAttachment[]

  @@unique([organizationId, code])
  @@index([organizationId, clinicId, status, dueAt])
}

model LabCaseEvent {
  id          String        @id @default(uuid()) @db.Uuid
  labCaseId   String        @db.Uuid
  status      LabCaseStatus
  notes       String?
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  labCase     LabCase       @relation(fields: [labCaseId], references: [id])

  @@index([labCaseId, createdAt])
}

model LabCaseStageEvent {
  id           String   @id @default(uuid()) @db.Uuid
  labCaseId    String   @db.Uuid
  stage        String
  notes        String?
  trackingCode String?
  actorId      String?  @db.Uuid
  occurredAt   DateTime @default(now())
  metadata     Json     @default("{}")
  labCase      LabCase  @relation(fields: [labCaseId], references: [id], onDelete: Cascade)

  @@index([labCaseId, occurredAt])
}

model LabCaseAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  labCaseId   String   @db.Uuid
  fileId      String   @db.Uuid
  label       String?
  kind        String   @default("DOCUMENT")
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  labCase     LabCase  @relation(fields: [labCaseId], references: [id], onDelete: Cascade)

  @@index([labCaseId, createdAt])
}

model Notification {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  clinicId       String?              @db.Uuid
  userId         String?              @db.Uuid
  category       NotificationCategory
