{
  "name": "sonder-clinic",
  "private": true,
  "version": "1.3.19",
  "description": "ERP Odontológico Interno — Sonder Clinic",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "corepack pnpm -r --parallel dev",
    "dev:web": "corepack pnpm --filter @sonder/web dev",
    "dev:api": "corepack pnpm --filter @sonder/api dev",
    "dev:worker": "corepack pnpm --filter @sonder/worker dev",
    "build": "corepack pnpm -r build",
    "lint": "eslint .",
    "lint:commit": "commitlint --last --verbose",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "test:integration": "corepack pnpm -r test:integration",
    "test:e2e": "corepack pnpm --filter @sonder/web test:e2e",
    "db:generate": "corepack pnpm --filter @sonder/database generate",
    "db:migrate": "corepack pnpm --filter @sonder/database migrate:dev",
    "db:deploy": "corepack pnpm --filter @sonder/database migrate:deploy",
    "db:bootstrap": "corepack pnpm --filter @sonder/database bootstrap:production",
    "db:seed": "corepack pnpm --filter @sonder/database seed",
    "db:reset": "corepack pnpm --filter @sonder/database reset",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1"
  }
}
